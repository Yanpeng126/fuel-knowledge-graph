{
  "quantization": {
    "bits": 4,
    "type": "nf4",
    "double_quantization": true
  },
  "lora": {
    "rank": 8,
    "alpha": 16,
    "dropout": 0.05,
    "bias": "none",
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj"
    ]
  },
  "max_length": 20480,
  "packing": false,
  "epochs": 1,
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 8,
  "learning_rate": 0.0002,
  "scheduler": "cosine",
  "warmup_ratio": 0.03,
  "optimizer": "paged_adamw_8bit",
  "gradient_checkpointing": true,
  "eval_strategy": "no",
  "save_steps": 50,
  "save_total_limit": 2,
  "compute_dtype": "bfloat16 for CUDA compute capability >=8, otherwise float16"
}
